# Configuração exclusiva do servidor Next.js. Não usar service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Origem pública exata do Next.js; troque pelo domínio HTTPS na produção.
DELTA_APP_ORIGIN=http://localhost:3000
# Origem da API Python, sem caminho; HTTPS ou HTTP em localhost.
DELTA_API_URL=http://localhost:8000
